{
  "name": "discord-bot",
  "type": "module",
  "version": "0.3.0",
  "description": "Discord bot made for espn fantasy football",
  "main": "index.ts",
  "scripts": {
    "start": "tsx index.ts",
    "dev": "tsx watch index.ts",
    "dev:node": "nodemon --exec tsx index.ts",
    "test": "NODE_OPTIONS='--experimental-vm-modules' jest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@vercel/postgres": "^0.10.0",
    "date-fns": "^3.6.0",
    "date-fns-tz": "^3.1.3",
    "discord.js": "^14.15.2",
    "espn-fantasy-football-api": "2.0.1",
    "express": "^4.17.1",
    "node-cron": "^4.2.1",
    "node-fetch": "^3.3.2",
    "openai": "^4.47.2",
    "pg": "8.7.1",
    "tsx": "^4.21.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/preset-typescript": "^7.28.5",
    "@types/express": "^5.0.6",
    "@types/node": "^25.0.3",
    "@types/node-cron": "^3.0.11",
    "dotenv": "^16.0.2",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.5.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.4",
    "prettier": "^3.7.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.50.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/wpfl-eng/discord-bot"
  },
  "keywords": [
    "node",
    "heroku",
    "express"
  ],
  "license": "MIT",
  "engines": {
    "node": "20.15.1"
  }
}
